<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1><%= t '.title' %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to t(:show), book %>
      <%#= link_to "Show this book", book %>
    </p>
  <% end %>
</div>

<%= link_to t(:new), new_book_path %>
