<p style="color: green"><%= notice %></p>

<% title = t('views.common.title_index', name: i18n_pluralize(User.model_name.human)) %>
<% content_for :title, title %>

<h1><%= title %></h1>

<ul>
  <% @users.each do |user| %>
    <li>
      <p><%= user.email %></p>
      <div>
        <%= link_to t('views.common.show', name: User.model_name.human.downcase), user %>
      </div>
    </li>
  <% end %>
</ul>

<%= paginate @users %>

<nav class="page-nav">
  <%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete } %>
  <%= link_to 'アカウント編集', edit_user_registration_path %>
  <%= link_to '本の一覧', books_path %>
</nav>
