<% title = t('views.common.title_index', name: i18n_pluralize(User.model_name.human)) %>
<% content_for :title, title %>

<h1><%= title %></h1>

<ul>
  <% @users.each do |user| %>
    <li>
      <p><%= user.email %></p>
      <div>
        <%= link_to t('views.common.show', name: User.model_name.human.downcase), user %>
      </div>
    </li>
  <% end %>
</ul>

<%= paginate @users %>

<nav class="page-nav">
  <%= link_to t('devise.sessions.new.sign_out'), destroy_user_session_path, data: { turbo_method: :delete } %>
  <%= link_to t('devise.registrations.edit.account'), edit_user_registration_path %>
  <%= link_to t('views.common.title_index', name: Book.model_name.human.downcase), root_path %>
</nav>
