<div class="comment-item">
  <div class="comment-header">
    <div><%= current_user_name(User.find(comment.user_id)) %></div>
    <div><%= l comment.created_at %></div>
  </div>
  <p><%= comment.content %></p>
  <div class="comment-footer">
    <% if comment.user == current_user %>
      <div>
        <%= link_to '編集する', edit_report_comment_path(commentable, comment) %>
      </div>
      <div>
        <%= button_to '削除する', report_comment_path(commentable, comment), method: :delete %>
      </div>
    <% end %>
  </div>
</div>
