<% title = t('views.common.title_new', name: Report.model_name.human) %>
<% content_for :title, title %>

<h1><%= title %></h1>

<%= form_with model: @report do |form| %>
  <% if @report.errors.any? %>
    <div style="color: red">
      <h2><%= t('views.common.validation_error', errors: i18n_error_count(@report.errors.count), name: Report.model_name.human.downcase) %>:</h2>
      <ul>
        <% @report.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :target_date, style: "display: block" %>
    <%= form.date_field :target_date %>
  </div>
  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.textarea :content %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>

<nav class="page-nav">
  <%= link_to t('views.common.back', name: Report.model_name.human), reports_path %>
</nav>
