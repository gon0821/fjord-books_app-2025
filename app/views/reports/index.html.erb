
<% title = t('views.common.title_index', name: i18n_pluralize(Report.model_name.human)) %>
<% content_for :title, title %>

<h1><%= title %></h1>

<nav class="page-nav">
  <%= link_to t('views.common.new', name: Report.model_name.human.downcase), new_report_path %>
</nav>

<div class="card-list-items">
  <% @reports.each do |report| %>
    <div class="card-list-item">
      <h2 class="card-list-item-title">
        <%= link_to report.title, report %>
      </h2>
      <div class="card-list-item-meta">
        <div class="card-list-item-meta__item">
          <%= link_to current_user_name(report.user), report.user %>
        </div>
        <div class="card-list-item-meta__item">
          <%= report.target_date %>の日報
        </div>
      </div>
    </div>
  <% end %>
</div>
